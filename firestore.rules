rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read/write their own profile; Admin can read for authentication/role checks
    match /Users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Administrative User Summaries (contains ONLY name, email, uid, submissionCount)
    // Accessible strictly by Master Admin for user management dashboard
    match /AdminUserSummaries/{userId} {
      allow read: if isAdmin();
      allow write: if false; // Maintained server-side via trusted Cloud Functions
    }
    
    // Founder Profiles - Strictly Owner-Only (No Admin Access)
    match /FounderProfiles/{profileId} {
      allow create, read, update, delete: if request.auth != null && (request.auth.uid == profileId || (resource != null && resource.data.userId == request.auth.uid));
    }

    // Founder CV Metadata - Strictly Owner-Only (No Admin Access)
    match /FounderCVMetadata/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Evaluation Drafts Collection - Strictly Owner-Only (No Admin Access to idea content)
    match /EvaluationDrafts/{draftId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
    
    // Idea Inputs - Strictly Owner-Only (No Admin Access)
    match /IdeaInputs/{inputId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Evaluation Scores & Reports - Strictly Owner-Only (No Admin Access)
    match /EvaluationScore/{evalId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Written via Cloud Functions
    }

    // Private Shares Collection - Founder Owner Only for direct queries
    match /PrivateShares/{shareToken} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Managed via Callable Cloud Functions
    }

    // Sanitised Public Idea Profiles - Publicly readable when published
    match /PublicIdeaProfiles/{publicId} {
      allow read: if resource.data.isPublished == true || (request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()));
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Invitations collection rules
    match /Invitations/{token} {
      allow get: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']);
      allow read, write, delete: if isAdmin();
    }

    // Expressions of Interest (Contact Founder Relay)
    match /ExpressionsOfInterest/{docId} {
      allow create: if true;
      allow read, update: if request.auth != null && resource.data.ownerUserId == request.auth.uid;
    }

    // Beta Feedback collection rules
    match /BetaFeedback/{feedbackId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete, update: if isAdmin();
    }

    // Submission Progress - Authenticated founders can read progress documents
    match /SubmissionProgress/{subId} {
      allow read: if request.auth != null;
      allow write: if false; // Maintained server-side via trusted Cloud Functions
    }
  }
}
