rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can only read/write their own profile
    match /Users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Founder Profiles
    match /FounderProfiles/{profileId} {
      allow create, read, update, delete: if request.auth != null && (request.auth.uid == profileId || resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    // Founder CV Metadata
    match /FounderCVMetadata/{userId} {
      allow create, read, update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Users can only read/write their own idea inputs
    match /IdeaInputs/{inputId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Users can only read their own evaluation scores unless marked as public
    match /EvaluationScore/{evalId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.isPublic == true || isAdmin());
      // Evaluations are written by Cloud Functions, but we allow users to update the 'isPublic' flag
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPublic']);
      allow write: if false;
    }

    // Invitations collection rules
    match /Invitations/{token} {
      allow get: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']);
      allow read, write, delete: if isAdmin();
    }

    // Beta Feedback collection rules
    match /BetaFeedback/{feedbackId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete, update: if isAdmin();
    }
  }
}
